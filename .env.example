# Copy this file to ".env" (same folder as rc_audit_trail.py) and fill in the values.
# .env holds secrets: it is listed in .gitignore. Never commit, email or paste it anywhere.

# --- Required: RingCentral API access (JWT auth flow) ---------------------------------
# Production is https://platform.ringcentral.com ; use https://platform.devtest.ringcentral.com only for sandbox apps.
RC_SERVER_URL=https://platform.ringcentral.com
# From the Developer Console > your app > Credentials
RC_CLIENT_ID=
RC_CLIENT_SECRET=
# One long string starting "eyJ", generated for an admin user (Developer Console > Credentials > JWT credentials).
# Paste ONLY the string on this one line: no quotes, no braces, no line breaks.
RC_JWT=

# --- Optional: tuning ------------------------------------------------------------------
# Records requested per API page (default 250). Lower it, e.g. 100, if RingCentral rejects the request.
# RC_PER_PAGE=250

# --- Optional: where to keep history ---------------------------------------------------
# json (default) | db (SQLite) | postgres | mssql | both (= json + db) | none. Comma list allowed, e.g. json,postgres
RC_SAVE=json
# SQLite file location (default: output/audit_trail.db)
# RC_DB_PATH=

# --- Optional: server databases (only needed with --save postgres / mssql) -----------
# RC_PG_DSN=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# RC_MSSQL_CONN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=HOST;DATABASE=DBNAME;UID=USER;PWD=PASSWORD;Encrypt=yes
